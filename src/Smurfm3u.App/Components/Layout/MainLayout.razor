@inherits LayoutComponentBase
@using Smurfm3u.Core

<AuthorizeView>
    <Authorized>
        <div class="shell">
            <nav class="sidebar">
                <div class="brand">Smurf<span>m3u</span></div>
                <div class="nav">
                    <NavLink href="" Match="NavLinkMatch.All">Dashboard</NavLink>
                    <NavLink href="search">Search</NavLink>
                    <NavLink href="queue">Queue</NavLink>
                    <NavLink href="history">Download History</NavLink>
                    <NavLink href="sources">Playlists</NavLink>
                    <NavLink href="searches">Search History</NavLink>
                    <NavLink href="settings">Settings</NavLink>
                </div>
                <div class="sidebar-footer">
                    <div>@context.User.Identity?.Name</div>
                    <div class="version" title="@VersionTitle">@VersionLabel</div>
                    <form action="/account/logout" method="post">
                        <AntiforgeryToken />
                        <button type="submit" class="small" style="margin-top:.4rem">Sign out</button>
                    </form>
                </div>
            </nav>
            <main class="content">
                @Body
            </main>
        </div>
    </Authorized>
    <NotAuthorized>
        @* Unauthenticated pages (login, errors) render without the chrome. *@
        @Body
    </NotAuthorized>
</AuthorizeView>

@code {
    // Built here rather than as "v@AppVersion.Display" in the markup: Razor reads a letter,
    // an @ and something dotted as an email address and emits it as text, so that rendered
    // the expression itself instead of the version.
    private static string VersionLabel => $"v{AppVersion.Display}";

    // Only worth showing when there is one; a build from outside a checkout has no commit.
    private static string? VersionTitle =>
        AppVersion.Commit is { } commit ? $"Built from {commit}" : null;
}
