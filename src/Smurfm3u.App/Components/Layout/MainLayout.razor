@inherits LayoutComponentBase
@using Smurfm3u.Core

<AuthorizeView>
    <Authorized>
        <div class="shell">
            <nav class="sidebar">
                @*
                    The same file the tab icon comes from, so the mark cannot drift between
                    the two places it appears. Decorative: the wordmark beside it already
                    says what it is, and a screen reader repeating it helps nobody.
                *@
                <div class="brand">
                    <img src="@Assets["favicon.svg"]" alt="" width="24" height="24" />
                    <span class="brand-name">Smurf<span>m3u</span></span>
                </div>
                <div class="nav">
                    @* Day to day first, then what is set up once, then what is looked back at. *@
                    <NavLink href="" Match="NavLinkMatch.All"><Icon Name="IconName.Dashboard" />Dashboard</NavLink>
                    <NavLink href="queue"><Icon Name="IconName.Queue" />Queue</NavLink>
                    <NavLink href="search"><Icon Name="IconName.Search" />Search</NavLink>
                    <NavLink href="sources"><Icon Name="IconName.Playlists" />Playlists</NavLink>
                    <NavLink href="settings"><Icon Name="IconName.Settings" />Settings</NavLink>
                    <NavLink href="cache"><Icon Name="IconName.Cache" />Cache</NavLink>
                    <NavLink href="history"><Icon Name="IconName.DownloadHistory" />Download History</NavLink>
                    <NavLink href="searches"><Icon Name="IconName.SearchHistory" />Search History</NavLink>
                    <NavLink href="logs"><Icon Name="IconName.Logs" />Logs</NavLink>
                </div>
                <div class="sidebar-footer">
                    <div class="version" title="@VersionTitle">@VersionLabel</div>
                </div>
            </nav>
            <main class="content">
                <header class="topbar">
                    <div class="user">User: <strong>@context.User.Identity?.Name</strong></div>
                    <div class="actions">
                        @*
                            Plain JavaScript rather than an @@onclick handler: the layout is
                            rendered statically, so a Blazor handler here would never fire, and
                            the theme is a client-side preference with nothing to tell the
                            server about anyway.
                        *@
                        <button type="button" class="icon-button theme-toggle" onclick="toggleTheme()"
                                title="Switch between the dark and light theme" aria-label="Switch theme">
                            <Icon Name="IconName.Sun" Class="icon-sun" />
                            <Icon Name="IconName.Moon" Class="icon-moon" />
                        </button>
                        <form action="/account/logout" method="post">
                            <AntiforgeryToken />
                            <button type="submit" class="small">Sign out</button>
                        </form>
                    </div>
                </header>
                <div class="page">
                    @Body
                </div>
            </main>
        </div>
    </Authorized>
    <NotAuthorized>
        @* Unauthenticated pages (login, errors) render without the chrome. *@
        @Body
    </NotAuthorized>
</AuthorizeView>

@code {
    // Built here rather than as "v@AppVersion.Display" in the markup: Razor reads a letter,
    // an @ and something dotted as an email address and emits it as text, so that rendered
    // the expression itself instead of the version.
    private static string VersionLabel => $"v{AppVersion.Display}";

    // Only worth showing when there is one; a build from outside a checkout has no commit.
    private static string? VersionTitle =>
        AppVersion.Commit is { } commit ? $"Built from {commit}" : null;
}
