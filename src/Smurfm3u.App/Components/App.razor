<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    @*
        Inline and before the stylesheet on purpose: a stored choice has to be on the element
        before the first paint, or every page load flashes the other theme first. With nothing
        stored the attribute stays off and the CSS follows the system preference.
    *@
    <script>
        (function () {
            try {
                var stored = localStorage.getItem('smurfm3u-theme');
                if (stored === 'light' || stored === 'dark') {
                    document.documentElement.dataset.theme = stored;
                }
            } catch (e) {
                // Storage blocked (private window, or cookies off): the system preference stands.
            }
        })();

        function toggleTheme() {
            var root = document.documentElement;
            var current = root.dataset.theme
                || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
            var next = current === 'light' ? 'dark' : 'light';

            root.dataset.theme = next;

            try {
                localStorage.setItem('smurfm3u-theme', next);
            } catch (e) {
                // Not persisted, but the page still changes for as long as it is open.
            }
        }
    </script>

    <ResourcePreloader />
    <link rel="icon" href="@Assets["favicon.svg"]" type="image/svg+xml" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Smurfm3u.App.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    @*
        Remembers whether Administration was folded away. Run straight after the markup so a
        folded group never paints open first, and again after every enhanced navigation,
        because that re-renders the layout with the group open. It always opens on one of its
        own pages, so the current page is never hidden.
    *@
    <script>
        function syncAdminNav() {
            var group = document.querySelector('.nav-group');
            if (!group) return;
            if (group.querySelector('a.active')) {
                group.open = true;
                return;
            }
            try {
                group.open = localStorage.getItem('smurfm3u-admin-nav') !== 'closed';
            } catch (e) {
                // Storage blocked: it stays as rendered, open.
            }
        }

        // On the click rather than the toggle event, which also fires when the sync above
        // opens it, and would then record a choice nobody made.
        document.addEventListener('click', function (e) {
            var summary = e.target.closest('.nav-group > summary');
            if (!summary) return;
            try {
                // Still the state before the click takes effect.
                localStorage.setItem('smurfm3u-admin-nav', summary.parentElement.open ? 'closed' : 'open');
            } catch (e) {
                // Not remembered, but it still folds for now.
            }
        });

        syncAdminNav();
    </script>
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script>Blazor.addEventListener('enhancedload', syncAdminNav);</script>
</body>

</html>
