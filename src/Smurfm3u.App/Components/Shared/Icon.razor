@* 
    Inline SVG rather than an icon font or a sprite: there is nothing to fetch, which matters
    on an instance behind a proxy or with no outbound access, and currentColor means an icon
    takes the colour of the text beside it in either theme.
*@

<svg class="icon @Class" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case IconName.Dashboard:
            <rect x="3" y="3" width="7.5" height="7.5" rx="1.5" />
            <rect x="13.5" y="3" width="7.5" height="7.5" rx="1.5" />
            <rect x="3" y="13.5" width="7.5" height="7.5" rx="1.5" />
            <rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.5" />
            break;

        case IconName.Search:
            <circle cx="10.5" cy="10.5" r="6.5" />
            <path d="m15.5 15.5 4.5 4.5" />
            break;

        case IconName.Queue:
            <path d="M12 3v11" />
            <path d="m7.5 9.5 4.5 4.5 4.5-4.5" />
            <path d="M4 20h16" />
            break;

        case IconName.DownloadHistory:
            <circle cx="12" cy="12" r="8.5" />
            <path d="M12 6.8V12l3.4 2" />
            break;

        case IconName.Playlists:
            <path d="M4 6h11" />
            <path d="M4 12h11" />
            <path d="M4 18h7" />
            <path d="m15.5 13.5 5.5 3.25-5.5 3.25z" fill="currentColor" />
            break;

        case IconName.SearchHistory:
            <path d="M6.5 3h7L19 8.5V21H6.5z" />
            <path d="M13.5 3v5.5H19" />
            <path d="M9.5 13h6" />
            <path d="M9.5 17h4" />
            break;

        case IconName.Settings:
            <path d="M4 7.5h8.5" />
            <path d="M18.5 7.5H20" />
            <circle cx="15.5" cy="7.5" r="2.4" />
            <path d="M4 16.5h1.5" />
            <path d="M11.5 16.5H20" />
            <circle cx="8.5" cy="16.5" r="2.4" />
            break;

        case IconName.Sun:
            <circle cx="12" cy="12" r="4.2" />
            <path d="M12 2.5v2.2M12 19.3v2.2M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6" />
            break;

        case IconName.Moon:
            <path d="M20.5 14.3A8.7 8.7 0 0 1 9.7 3.5a8.7 8.7 0 1 0 10.8 10.8z" />
            break;

        case IconName.SignOut:
            <path d="M14.5 7.5V5.5a1.5 1.5 0 0 0-1.5-1.5H6a1.5 1.5 0 0 0-1.5 1.5v13A1.5 1.5 0 0 0 6 20h7a1.5 1.5 0 0 0 1.5-1.5v-2" />
            <path d="M10 12h10" />
            <path d="m17 9 3 3-3 3" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public IconName Name { get; set; }

    /// <summary>Extra classes, used to tell the two theme icons apart in CSS.</summary>
    [Parameter] public string? Class { get; set; }
}
