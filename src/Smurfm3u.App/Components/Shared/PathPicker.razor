@using Smurfm3u.Core.Models

@* A path box with a folder browser behind it. The browser opens over the page rather than
   inside the form, so it has room to list and cannot push the layout around. *@

<div class="actions">
    <input class="mono" value="@Value" placeholder="@Placeholder" @onchange="OnTypedAsync" />
    <button type="button" class="@ButtonClass" @onclick="OpenAsync">Browse</button>
</div>

@if (listing is not null)
{
    <div class="modal-backdrop" @onclick="Close">
        @* Clicks inside the dialog are not clicks on the backdrop. *@
        <div class="modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <strong>@(FoldersOnly ? "Choose a folder" : "Choose a file")</strong>
                <button type="button" class="small" @onclick="Close">Close</button>
            </div>

            <div class="modal-path">
                <button type="button" class="small" @onclick="UpAsync" disabled="@(listing.Parent is null)">
                    &uarr; Up
                </button>
                <span class="mono">@listing.Path</span>
            </div>

            <div class="modal-body">
                @if (listing.Error is { Length: > 0 } error)
                {
                    <p class="muted">@error</p>
                }
                else if (listing.Items.Count == 0)
                {
                    <p class="muted">@(FoldersOnly ? "No folders here." : "Nothing here to pick.")</p>
                }
                else
                {
                    <table>
                        <tbody>
                        @foreach (var item in listing.Items)
                        {
                            <tr>
                                <td>
                                    <button type="button" class="link-button" @onclick="() => PickAsync(item)">
                                        @(item.IsDirectory ? $"{item.Name}/" : item.Name)
                                    </button>
                                </td>
                                <td class="numeric muted">@(item.IsDirectory ? "" : SabFormat.Size(item.SizeBytes))</td>
                                <td class="muted">
                                    @(item.ModifiedAt == default ? "" : item.ModifiedAt.LocalDateTime.ToString("d MMM yyyy"))
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
            </div>

            <div class="modal-footer">
                <span class="muted">@(FoldersOnly ? "Open a folder to step into it." : "Open a folder, or pick a file.")</span>
                <div class="actions">
                    @if (FoldersOnly)
                    {
                        <button type="button" class="primary" @onclick="UseThisFolderAsync">Use this folder</button>
                    }
                    <button type="button" @onclick="Close">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Pick a folder rather than a file: no files are listed and a folder is the answer.</summary>
    [Parameter] public bool FoldersOnly { get; set; }

    /// <summary>Extensions worth offering, e.g. .m3u. Null lists every file.</summary>
    [Parameter] public IReadOnlyList<string>? Extensions { get; set; }

    /// <summary>Where to open when the field is empty.</summary>
    [Parameter] public string Fallback { get; set; } = "/";

    [Parameter] public string? Placeholder { get; set; }

    [Parameter] public string ButtonClass { get; set; } = string.Empty;

    private FolderListing? listing;

    private IReadOnlyList<string>? Filter => FoldersOnly ? [] : Extensions;

    /// <summary>
    /// Opens where the current value already points, so editing a path does not start again
    /// from the root every time.
    /// </summary>
    private void OpenAsync() => Show(FileBrowser.StartingFolderFor(Value, Fallback));

    private void Close() => listing = null;

    private void UpAsync()
    {
        if (listing?.Parent is { } parent) Show(parent);
    }

    private void Show(string path) => listing = FileBrowser.List(path, Filter);

    private async Task PickAsync(BrowseItem item)
    {
        // A folder is somewhere to go. Choosing one as the answer is what "Use this folder"
        // is for, so that a folder-only picker can still be navigated.
        if (item.IsDirectory)
        {
            Show(item.FullPath);
            return;
        }

        await CommitAsync(item.FullPath);
    }

    private Task UseThisFolderAsync() =>
        listing is null ? Task.CompletedTask : CommitAsync(listing.Path);

    private async Task CommitAsync(string path)
    {
        Value = path;
        listing = null;
        await ValueChanged.InvokeAsync(path);
    }

    private Task OnTypedAsync(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? string.Empty;
        return ValueChanged.InvokeAsync(Value);
    }
}
