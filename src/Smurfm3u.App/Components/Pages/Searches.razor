@page "/searches"
@attribute [Authorize]
@rendermode InteractiveServer
@inject SearchHistoryService History

<PageTitle>Search history - Smurfm3u</PageTitle>

<div class="page-header">
    <h1>Search history</h1>
    <div class="actions">
        <input placeholder="Filter by query" @bind="filter" @bind:event="oninput" @bind:after="ReloadAsync"
               style="width:200px" />
        <select @bind="pruneDays" style="width:auto">
            <option value="90">older than 90 days</option>
            <option value="30">older than 30 days</option>
            <option value="7">older than 7 days</option>
            <option value="1">older than 1 day</option>
            <option value="0">everything</option>
        </select>
        <button class="danger" @onclick="PruneAsync">Delete</button>
    </div>
</div>

@if (message is not null)
{
    <div class="alert ok">@message</div>
}

<p class="muted">
    @total.ToString("N0") recorded searches. Prowlarr, Sonarr and Radarr appear here as they query the indexer.
</p>

@if (entries.Count == 0)
{
    <div class="card empty">No searches recorded yet.</div>
}
else
{
    <div class="card" style="padding:0">
        <table>
            <thead>
            <tr>
                <th>When</th>
                <th class="secondary">Type</th>
                <th>Query</th>
                <th>Episode</th>
                <th class="numeric secondary">Page</th>
                <th class="numeric">Results</th>
                <th class="numeric secondary">Took</th>
                <th class="secondary">Client</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var entry in entries)
            {
                <tr>
                    <td class="muted">@entry.RequestedAt.LocalDateTime.ToString("d MMM HH:mm:ss")</td>
                    <td class="secondary"><span class="pill">@Label(entry.Kind)</span></td>
                    <td>@(string.IsNullOrWhiteSpace(entry.Query) ? "(browse)" : entry.Query)</td>
                    <td class="mono">@EpisodeLabel(entry)</td>
                    <td class="numeric mono secondary" title="offset @entry.Offset, limit @entry.Limit">@PageLabel(entry)</td>
                    <td class="numeric">
                        <span class="@(entry.ResultCount == 0 ? "muted" : "")">@entry.ResultCount</span>
                        @if (entry.Relaxed)
                        {
                            <span class="pill warn" title="No entry had every word; the closest were returned">closest</span>
                        }
                    </td>
                    <td class="numeric muted secondary">@entry.ElapsedMs ms</td>
                    <td class="muted secondary" style="max-width:220px;overflow:hidden;text-overflow:ellipsis">
                        @ClientLabel(entry)
                    </td>
                    <td>
                        <div class="actions">
                            <button class="small" @onclick="() => ToggleResultsAsync(entry)"
                                    disabled="@(entry.ResultCount == 0)">
                                @(expanded == entry.Id ? "Hide" : "Results")
                            </button>
                            <button class="small danger" @onclick="() => DeleteAsync(entry.Id)">Delete</button>
                        </div>
                    </td>
                </tr>

                @if (expanded == entry.Id)
                {
                    <tr>
                        <td colspan="9" class="result-cell">
                            @if (results.Count == 0)
                            {
                                <span class="muted">
                                    Nothing was recorded against this search. Only searches answered
                                    after this was added remember what they returned.
                                </span>
                            }
                            else
                            {
                                <ol class="result-list">
                                    @foreach (var result in results)
                                    {
                                        <li>
                                            <span class="mono @(result.StillListed ? "" : "muted")">@result.ReleaseName</span>
                                            @if (result.SourceName is { Length: > 0 } playlist)
                                            {
                                                <span class="muted"> &mdash; @playlist</span>
                                            }
                                            @if (!result.StillListed)
                                            {
                                                <span class="pill warn">retired</span>
                                            }
                                        </li>
                                    }
                                </ol>
                                @if (results.Count < entry.ResultCount)
                                {
                                    <div class="hint">
                                        Showing the first @results.Count of @entry.ResultCount; only that many are kept.
                                    </div>
                                }
                            }
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>

    <Pager Page="page" PageSize="pageSize" TotalCount="total"
           PageChanged="GoToPageAsync" PageSizeChanged="SetPageSizeAsync" />
}

@code {
    private readonly List<SearchHistoryEntry> entries = [];
    private string filter = string.Empty;
    private int pruneDays = 30;
    private int total;
    private int page = 1;
    private int pageSize = 50;
    private string? message;

    /// <summary>The one row whose results are open, and the results themselves.</summary>
    private long? expanded;
    private IReadOnlyList<RecordedResult> results = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    /// <summary>A changed filter or a deletion can leave the current page past the end.</summary>
    private Task ReloadAsync()
    {
        page = 1;
        message = null;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await History.GetPageAsync((page - 1) * pageSize, pageSize, filter);
        total = result.TotalCount;

        entries.Clear();
        entries.AddRange(result.Entries);

        // Deleting the last row of the last page would otherwise strand us on an empty one.
        if (entries.Count == 0 && page > 1)
        {
            page = 1;
            await LoadAsync();
        }
    }

    private Task GoToPageAsync(int target)
    {
        page = target;
        return LoadAsync();
    }

    private Task SetPageSizeAsync(int size)
    {
        pageSize = size;
        page = 1;
        return LoadAsync();
    }

    private async Task ToggleResultsAsync(SearchHistoryEntry entry)
    {
        if (expanded == entry.Id)
        {
            expanded = null;
            results = [];
            return;
        }

        // Loaded on demand: a page of fifty searches is thousands of releases nobody asked
        // to see, and the names have to be rebuilt from their playlists to show them.
        results = await History.GetResultsAsync(entry.Id);
        expanded = entry.Id;
    }

    private async Task DeleteAsync(long id)
    {
        await History.DeleteAsync(id);

        // Stay where we are: removing one row should not send the reader back to the start.
        await LoadAsync();
    }

    private async Task PruneAsync()
    {
        var removed = await History.DeleteOlderThanAsync(pruneDays);
        await ReloadAsync();
        message = $"Deleted {removed:N0} entries.";
    }

    private static string Label(SearchKind kind) => kind switch
    {
        SearchKind.TvSearch => "TV",
        SearchKind.MovieSearch => "Movie",
        SearchKind.Caps => "Caps",
        _ => "Search"
    };

    /// <summary>
    /// Which page of a walk this was. A client that pages through a large result set sends
    /// the same query over and over, and only the offset tells one request from the next.
    /// </summary>
    private static string PageLabel(SearchHistoryEntry entry)
    {
        if (entry.Limit <= 0) return entry.Offset == 0 ? "-" : entry.Offset.ToString();

        return ((entry.Offset / entry.Limit) + 1).ToString();
    }

    private static string EpisodeLabel(SearchHistoryEntry entry) =>
        (entry.Season, entry.Episode) switch
        {
            (null, null) => "-",
            ({ } s, null) => $"S{s:D2}",
            (null, { } e) => $"E{e:D2}",
            ({ } s, { } e) => $"S{s:D2}E{e:D2}"
        };

    private static string ClientLabel(SearchHistoryEntry entry)
    {
        var agent = entry.UserAgent ?? string.Empty;

        // The *arr apps send a long UA; the leading product token is the useful part.
        var product = agent.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "unknown";
        return entry.ClientIp is { Length: > 0 } ip ? $"{product} ({ip})" : product;
    }
}
