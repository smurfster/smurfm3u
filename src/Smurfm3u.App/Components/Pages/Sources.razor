@page "/sources"
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using Smurfm3u.Core.Models
@using Smurfm3u.Core.Diagnostics
@using Smurfm3u.Core.Options
@using Smurfm3u.Core.Xtream
@using Smurfm3u.Data
@attribute [Authorize]
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject M3uRefreshService Refresher
@inject SettingsService SettingsStore
@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider AuthState
@inject ILogger<Sources> Log
@inject RefreshProgress Progress
@implements IDisposable

<PageTitle>Playlists - Smurfm3u</PageTitle>

<div class="page-header">
    <h1>Playlists</h1>
    <div class="actions">
        <button class="primary" @onclick="StartAdd">Add playlist</button>
    </div>
</div>

@if (message is not null)
{
    <div class="alert @(messageIsError ? "bad" : "ok")">@message</div>
}

@if (editing is not null)
{
    <div class="card">
        <h2 style="margin-top:0">@(editing.Id == 0 ? "Add playlist" : $"Edit {editing.Name}")</h2>

        <EditForm Model="editing" OnValidSubmit="SaveAsync" FormName="source">
            <DataAnnotationsValidator />

            <div class="field-grid">
                <div class="field">
                    <label>Name</label>
                    <InputText @bind-Value="editing.Name" />
                    <ValidationMessage For="() => editing.Name" class="validation-message" />
                </div>

                <div class="field">
                    <label>Type</label>
                    <InputSelect @bind-Value="editing.Kind">
                        <option value="@M3uSourceKind.Remote">Remote URL</option>
                        <option value="@M3uSourceKind.Local">Local file</option>
                        <option value="@M3uSourceKind.Xtream">Xtream panel</option>
                    </InputSelect>
                    @if (editing.Kind == M3uSourceKind.Xtream)
                    {
                        <div class="hint">
                            Read through the panel&#39;s API rather than as a playlist, so seasons,
                            episodes and containers come from the provider instead of being read
                            back out of entry names.
                        </div>
                    }
                </div>
            </div>

            <div class="field">
                <label>@LocationLabel(editing.Kind)</label>

                @if (editing.Kind == M3uSourceKind.Local)
                {
                    <PathPicker @bind-Value="editing.Location" Extensions="PlaylistExtensions"
                                Fallback="@playlistFallback" Placeholder="/playlists/vod.m3u" />
                }
                else
                {
                    <InputText @bind-Value="editing.Location" />
                }

                <div class="hint">@LocationHint(editing.Kind)</div>
                <ValidationMessage For="() => editing.Location" class="validation-message" />
            </div>

            @if (editing.Kind == M3uSourceKind.Xtream)
            {
                <div class="field-grid">
                    <div class="field">
                        <label>Username</label>
                        <InputText @bind-Value="editing.Username" />
                        <div class="hint">Leave blank if the address above already carries it.</div>
                    </div>

                    <div class="field">
                        <label>Password</label>
                        <InputText type="password" @bind-Value="editing.Password" />
                    </div>
                </div>

                <div class="field inline-field">
                    <InputCheckbox id="includeSeries" @bind-Value="editing.IncludeSeries" />
                    <label for="includeSeries" style="margin:0">Include series as well as films</label>
                </div>
                <div class="hint">
                    The episode list is one request per series, so a panel with thousands of them
                    takes a while to read. Films are a single request either way. After the first
                    read only the series the panel says have changed are asked about again.
                </div>

                @if (editing.IncludeSeries)
                {
                    <div class="field" style="max-width:16rem;margin-top:.9rem">
                        <label>Episode lists at once</label>
                        <InputNumber @bind-Value="editing.SeriesConcurrency" />
                        <div class="hint">
                            A ceiling, not a rate: a panel that answers
                            <span class="mono">429 Too Many Requests</span> pulls the refresh
                            below this and it earns its way back. 4 suits most panels. Raise it
                            only if the log shows no push-back; 1 is the gentlest.
                        </div>
                    </div>
                }

                <div class="actions" style="margin-top:.75rem">
                    <button type="button" @onclick="TestXtreamAsync" disabled="@testingPanel">
                        @(testingPanel ? "Testing..." : "Test connection")
                    </button>
                    <span class="muted">Uses what is on screen; no need to save first.</span>
                </div>
            }

            <div class="field-grid">
                <div class="field">
                    <label>Quality tag</label>
                    <InputText @bind-Value="editing.QualityTag" />
                    <div class="hint">Source tag in release names, e.g. WEB-DL.</div>
                </div>

                <div class="field">
                    <label>Resolution tag</label>
                    <InputText @bind-Value="editing.ResolutionTag" />
                    <div class="hint">e.g. 1080p. Leave blank to omit. Also picks the Newznab subcategory.</div>
                </div>

                <div class="field">
                    <label>Release group</label>
                    <InputText @bind-Value="editing.ReleaseGroup" />
                    <div class="hint">Suffix after the dash. Leave blank to omit.</div>
                </div>
            </div>

            <div class="field-grid">
                <div class="field">
                    <label>Simultaneous downloads</label>
                    <InputNumber @bind-Value="editing.MaxConcurrentDownloads" />
                    <div class="hint">Cap for this playlist. The global cap still applies.</div>
                </div>

                <div class="field">
                    <label>Pause between starts (seconds)</label>
                    <InputNumber @bind-Value="editing.StartDelaySeconds" />
                    <div class="hint">Wait this long before starting the next download from here.</div>
                </div>

                <div class="field">
                    <label>Speed limit (KiB/s)</label>
                    <InputNumber @bind-Value="editing.SpeedLimitKibps" />
                    <div class="hint">0 for no per-playlist limit.</div>
                </div>

                <div class="field">
                    <label>Refresh schedule (cron)</label>
                    <InputText @bind-Value="editing.RefreshCron" />
                    <div class="hint">Five fields, UTC. Blank disables scheduled refresh.</div>
                </div>
            </div>

            <div class="field">
                <label>Extra HTTP headers</label>
                <InputTextArea @bind-Value="editing.Headers" />
                <div class="hint">One per line as "Name: value". Used for the playlist fetch and downloads.</div>
            </div>

            <div class="field inline-field">
                <InputCheckbox id="enabled" @bind-Value="editing.Enabled" />
                <label for="enabled" style="margin:0">Enabled</label>
            </div>

            <div class="actions">
                <button type="submit" class="primary">Save</button>
                <button type="button" @onclick="() => editing = null">Cancel</button>
            </div>
        </EditForm>
    </div>
}

@if (sources.Count == 0)
{
    <div class="card empty">No playlists configured yet.</div>
}
else
{
    <div class="card" style="padding:0">
        <table>
            <thead>
            <tr>
                <th>Name</th>
                <th>Location</th>
                <th>Tags</th>
                <th>Status</th>
                <th class="numeric">VOD / total</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var source in sources)
            {
                <tr>
                    <td>
                        <strong>@source.Name</strong>
                        @if (!source.Enabled)
                        {
                            <span class="pill" style="margin-left:.4rem">Disabled</span>
                        }
                        <div class="muted" style="font-size:.8rem">
                            @(string.IsNullOrWhiteSpace(source.RefreshCron) ? "manual refresh only" : source.RefreshCron)
                            &middot; @source.MaxConcurrentDownloads concurrent
                        </div>
                    </td>
                    <td class="mono" style="max-width:280px;overflow:hidden;text-overflow:ellipsis">@source.Location</td>
                    <td class="mono">@TagPreview(source)</td>
                    <td>
                        <span class="pill @StatusClass(DisplayStatus(source))">@StatusLabel(DisplayStatus(source))</span>
                        @* The last run's error, but not while the next one is under way. *@
                        @if (!IsRefreshing(source) && source.LastRefreshError is { Length: > 0 })
                        {
                            <div class="muted" style="font-size:.8rem;max-width:280px">@source.LastRefreshError</div>
                        }
                    </td>
                    <td class="numeric">
                        @if (Progress.For(source.Id) is { } stage)
                        {
                            @* While it is running, what it is doing now beats what it found last time. *@
                            <div class="refresh-stage">@stage.Phase</div>

                            @if (stage.Percent is { } percent)
                            {
                                <div class="progress">
                                    <div class="progress-bar" style="width:@(percent)%"></div>
                                    <div class="progress-text">@percent%</div>
                                </div>
                                <div class="refresh-stage">
                                    @stage.Done.ToString("N0") / @stage.Total!.Value.ToString("N0")@Eta(stage)
                                </div>
                            }
                            else
                            {
                                @* No declared length, so nothing honest to divide by. *@
                                <div class="refresh-stage">@Described(stage.Done) so far</div>
                            }
                        }
                        else
                        {
                            <span>@source.VodEntries.ToString("N0") / @source.TotalEntries.ToString("N0")</span>
                        }
                    </td>
                    <td>
                        <div class="actions">
                            <button class="small" disabled="@IsRefreshing(source)"
                                    @onclick="() => RefreshAsync(source.Id)">
                                @(IsRefreshing(source) ? "Refreshing..." : "Refresh")
                            </button>
                            <button class="small" @onclick="() => ToggleAsync(source.Id)">
                                @(source.Enabled ? "Disable" : "Enable")
                            </button>
                            <button class="small" @onclick="() => StartEdit(source)">Edit</button>
                            <button class="small danger" @onclick="() => DeleteAsync(source.Id)">Delete</button>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <Pager Page="page" PageSize="pageSize" TotalCount="total"
           PageChanged="GoToPageAsync" PageSizeChanged="SetPageSizeAsync" />
}

@code {
    private readonly List<M3uSource> sources = [];
    private readonly HashSet<int> refreshing = [];

    private int total;
    private int page = 1;
    private int pageSize = 25;

    private SourceForm? editing;

    private static readonly string[] PlaylistExtensions = [".m3u", ".m3u8"];

    /// <summary>Where the picker opens when a new playlist has no path yet.</summary>
    private string playlistFallback = "/playlists";

    private string? message;
    private bool messageIsError;
    private bool testingPanel;

    private static string LocationLabel(M3uSourceKind kind) => kind switch
    {
        M3uSourceKind.Local => "File path inside the container",
        M3uSourceKind.Xtream => "Panel address",
        _ => "Playlist URL"
    };

    private static string LocationHint(M3uSourceKind kind) => kind switch
    {
        M3uSourceKind.Local => "Any path the container can read. Browse opens where this one points.",
        M3uSourceKind.Xtream => "The panel's address, e.g. http://line.example.com:8080. "
                                + "Pasting the whole get.php link works too: the credentials are taken from it.",
        _ => "The provider's get.php or .m3u8 link."
    };

    /// <summary>
    /// Checks the login with what is on screen, before anything is saved. Reports what the
    /// panel says about the account, since an expired line answers this and then nothing else.
    /// </summary>
    private async Task TestXtreamAsync()
    {
        if (editing is null) return;

        testingPanel = true;
        try
        {
            if (!XtreamCredentials.TryCreate(editing.Location, editing.Username, editing.Password, out var creds, out var error))
            {
                SetMessage(error, isError: true);
                return;
            }

            using var scope = ScopeFactory.CreateScope();
            var client = scope.ServiceProvider.GetRequiredService<XtreamClient>();
            var info = await client.AuthenticateAsync(creds, editing.Headers);

            var detail = new List<string>();
            if (info.Status is { Length: > 0 }) detail.Add(info.Status);
            if (info.MaxConnections is { Length: > 0 }) detail.Add($"{info.MaxConnections} connections");
            if (Expiry(info.Expires) is { } expires) detail.Add($"expires {expires:yyyy-MM-dd}");

            Log.LogInformation("{User} tested the panel at {Panel} as {PanelUser}: connected{Detail}",
                user, creds.BaseUrl, creds.Username,
                detail.Count > 0 ? $" ({string.Join(", ", detail)})" : string.Empty);

            SetMessage(
                detail.Count > 0
                    ? $"Connected to {creds.BaseUrl} ({string.Join(", ", detail)})."
                    : $"Connected to {creds.BaseUrl}.",
                isError: false);
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "{User} tested the panel at {Location} and it failed",
                user, SafeUrl.Redact(editing.Location));

            SetMessage($"Could not connect: {ex.Message}", isError: true);
        }
        finally
        {
            testingPanel = false;
        }
    }

    /// <summary>The panel reports expiry as a unix timestamp, or leaves it blank for no limit.</summary>
    private static DateTimeOffset? Expiry(string? value) =>
        long.TryParse(value, out var seconds) && seconds > 0
            ? DateTimeOffset.FromUnixTimeSeconds(seconds)
            : null;

    /// <summary>Who is making the changes, so the log says who as well as what.</summary>
    private string user = "someone";

    /// <summary>
    /// Drives the progress bars. Only ticks while something is actually refreshing, so an
    /// idle page costs nothing; a refresh the scheduler started moves it just the same.
    /// </summary>
    private PeriodicTimer? ticker;

    /// <summary>Bytes when a playlist is being read, entries when a panel is.</summary>
    private static string Described(long done) =>
        done > 1_000_000 ? NotificationComposer.FormatBytes(done) : done.ToString("N0");

    /// <summary>" · about 4m left", or nothing until the rate means something.</summary>
    private string Eta(RefreshStage stage)
    {
        if (stage.Remaining(DateTimeOffset.UtcNow) is not { } left) return string.Empty;

        return left.TotalMinutes >= 1
            ? $" · about {(int)left.TotalMinutes}m left"
            : $" · about {(int)left.TotalSeconds}s left";
    }

    private async Task TickAsync()
    {
        ticker = new PeriodicTimer(TimeSpan.FromSeconds(2));

        try
        {
            while (await ticker.WaitForNextTickAsync())
            {
                if (sources.All(x => Progress.For(x.Id) is null) && refreshing.Count == 0) continue;

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // The page has gone.
        }
    }

    public void Dispose() => ticker?.Dispose();

    private static string KindLabel(M3uSourceKind kind) => kind switch
    {
        M3uSourceKind.Local => "local file",
        M3uSourceKind.Xtream => "Xtream panel",
        _ => "remote playlist"
    };

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        user = state.User.Identity?.Name ?? "someone";

        // The picker opens at whichever folder is configured for playlists, not a guess.
        playlistFallback = (await SettingsStore.GetAsync()).PlaylistPath;
        await LoadAsync();

        _ = TickAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        total = await db.Sources.CountAsync();

        var rows = await db.Sources.AsNoTracking()
            .OrderBy(x => x.Name)
            .Skip(new PageRange(page, pageSize, total).Skip)
            .Take(pageSize)
            .ToListAsync();

        sources.Clear();
        sources.AddRange(rows);

        // Deleting the last playlist on the last page would otherwise leave an empty grid.
        if (sources.Count == 0 && page > 1)
        {
            page = 1;
            await LoadAsync();
        }
    }

    private Task GoToPageAsync(int target)
    {
        page = target;
        return LoadAsync();
    }

    private Task SetPageSizeAsync(int size)
    {
        pageSize = size;
        page = 1;
        return LoadAsync();
    }

    private void StartAdd()
    {
        editing = new SourceForm();
    }

    private void StartEdit(M3uSource source)
    {
        editing = SourceForm.From(source);
    }

    private async Task SaveAsync()
    {
        if (editing is null) return;

        await using var db = await DbFactory.CreateDbContextAsync();

        var entity = editing.Id == 0
            ? new M3uSource()
            : await db.Sources.FirstOrDefaultAsync(x => x.Id == editing.Id);

        if (entity is null)
        {
            SetMessage("That playlist no longer exists.", isError: true);
            editing = null;
            await LoadAsync();
            return;
        }

        editing.ApplyTo(entity);

        if (editing.Id == 0)
            db.Sources.Add(entity);

        // Asked of the change tracker before saving, while it still knows what moved. An added
        // entity reports every property as modified, so the list is only meaningful on an edit.
        var changed = editing.Id == 0
            ? []
            : db.Entry(entity).Properties
                .Where(p => p.IsModified)
                .Select(p => p.Metadata.Name)
                .OrderBy(x => x, StringComparer.Ordinal)
                .ToArray();

        try
        {
            await db.SaveChangesAsync();
        }
        catch (DbUpdateException)
        {
            // The only unique constraint on the table is the name.
            Log.LogWarning("{User} could not save playlist {Name}: the name is already taken", user, editing.Name);
            SetMessage($"A playlist called \"{editing.Name}\" already exists.", isError: true);
            return;
        }

        var isNew = editing.Id == 0;

        if (isNew)
        {
            Log.LogInformation(
                "{User} added playlist {Name}: {Kind} at {Location}, {Cron}, {Concurrency} at a time{Series}",
                user, entity.Name, KindLabel(entity.Kind), SafeUrl.Redact(entity.Location),
                string.IsNullOrWhiteSpace(entity.RefreshCron) ? "manual refresh only" : $"cron {entity.RefreshCron}",
                entity.MaxConcurrentDownloads,
                entity.Kind == M3uSourceKind.Xtream && !entity.IncludeSeries ? ", films only" : string.Empty);
        }
        else
        {
            // The field names, never their values: one of them is the panel password.
            Log.LogInformation("{User} updated playlist {Name}: changed {Fields}",
                user, entity.Name, changed.Length == 0 ? "nothing" : string.Join(", ", changed));
        }

        SetMessage(isNew ? $"Added {entity.Name}." : $"Saved {entity.Name}.", isError: false);
        editing = null;

        await LoadAsync();

        // A brand new playlist is empty until it is read, so start that straight away.
        if (isNew && entity.Enabled)
            await RefreshAsync(entity.Id);
    }

    private async Task RefreshAsync(int sourceId)
    {
        if (!refreshing.Add(sourceId)) return;

        var name = sources.FirstOrDefault(x => x.Id == sourceId)?.Name ?? sourceId.ToString();
        Log.LogInformation("{User} asked for a refresh of {Name}", user, name);

        try
        {
            // Runs on its own scope so a long refresh does not hold the circuit's services.
            using var scope = ScopeFactory.CreateScope();
            var refresher = scope.ServiceProvider.GetRequiredService<M3uRefreshService>();
            var result = await refresher.RefreshAsync(sourceId);

            SetMessage(
                // Not "lines": a panel is read as a catalogue, and has none.
                $"Found {result.VodEntries:N0} on-demand of {result.TotalEntries:N0} entries " +
                $"({result.Added:N0} new, {result.Deactivated:N0} gone) in {result.Elapsed.TotalSeconds:N1}s.",
                isError: false);
        }
        catch (Exception ex)
        {
            // The service has already logged the detail and recorded it against the source.
            SetMessage($"Refresh failed: {ex.Message}", isError: true);
        }
        finally
        {
            refreshing.Remove(sourceId);
            await LoadAsync();
        }
    }

    private async Task ToggleAsync(int sourceId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var source = await db.Sources.FirstOrDefaultAsync(x => x.Id == sourceId);
        if (source is null) return;

        source.Enabled = !source.Enabled;
        await db.SaveChangesAsync();

        Log.LogInformation("{User} {Action} playlist {Name}{Effect}",
            user, source.Enabled ? "enabled" : "disabled", source.Name,
            source.Enabled ? string.Empty : "; it is now skipped by search and by the scheduler");

        await LoadAsync();
    }

    private async Task DeleteAsync(int sourceId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var source = await db.Sources.FirstOrDefaultAsync(x => x.Id == sourceId);
        if (source is null) return;

        // Counted before the delete, because afterwards there is nothing left to count.
        var entries = await db.Items.CountAsync(x => x.SourceId == sourceId);

        // Entries cascade; finished downloads keep their rows with a null source.
        db.Sources.Remove(source);
        await db.SaveChangesAsync();

        Log.LogWarning("{User} deleted playlist {Name} and its {Entries} entries",
            user, source.Name, entries);

        SetMessage($"Deleted {source.Name} and its entries.", isError: false);
        await LoadAsync();
    }

    private void SetMessage(string text, bool isError)
    {
        message = text;
        messageIsError = isError;
    }

    private static string TagPreview(M3uSource source)
    {
        var parts = new[] { source.ResolutionTag, source.QualityTag }
            .Where(x => !string.IsNullOrWhiteSpace(x));

        var tags = string.Join('.', parts);
        return string.IsNullOrWhiteSpace(source.ReleaseGroup) ? tags : $"{tags}-{source.ReleaseGroup}";
    }

    /// <summary>
    /// Whether this playlist is being read right now, from either of the two things that know:
    /// a refresh this page started, and one already running when the row was loaded - which is
    /// what a scheduled refresh looks like from here.
    /// </summary>
    /// <remarks>
    /// Both the button and the status pill go through this. They used to disagree: the button
    /// watched the page's own set, which updates the moment it is clicked, while the pill read
    /// the status off a row loaded before the run started and not re-read until it ended. So a
    /// playlist that had failed kept saying "Failed" next to a button saying "Refreshing...".
    /// <para>
    /// The stored status disables the button as well, which is safe because a source left
    /// marked Running by a crash is reset at startup; without that it would be a row nobody
    /// could ever refresh again.
    /// </para>
    /// </remarks>
    private bool IsRefreshing(M3uSource source) =>
        refreshing.Contains(source.Id) || source.LastRefreshStatus == RefreshStatus.Running;

    private RefreshStatus DisplayStatus(M3uSource source) =>
        IsRefreshing(source) ? RefreshStatus.Running : source.LastRefreshStatus;

    private static string StatusLabel(RefreshStatus status) => status switch
    {
        RefreshStatus.Success => "OK",
        RefreshStatus.Running => "Refreshing",
        RefreshStatus.Failed => "Failed",
        _ => "Never run"
    };

    private static string StatusClass(RefreshStatus status) => status switch
    {
        RefreshStatus.Success => "ok",
        RefreshStatus.Running => "busy",
        RefreshStatus.Failed => "bad",
        _ => ""
    };

    /// <summary>Edit model, so a cancelled edit never leaves a half-changed entity tracked.</summary>
    private sealed class SourceForm
    {
        public int Id { get; set; }

        [Required(ErrorMessage = "Give the playlist a name.")]
        public string Name { get; set; } = string.Empty;

        public M3uSourceKind Kind { get; set; } = M3uSourceKind.Remote;

        [Required(ErrorMessage = "Enter a URL, file path or panel address.")]
        public string Location { get; set; } = string.Empty;

        public string? Username { get; set; }
        public string? Password { get; set; }
        public bool IncludeSeries { get; set; } = true;
        public int SeriesConcurrency { get; set; } = 4;

        public bool Enabled { get; set; } = true;
        public string QualityTag { get; set; } = "WEB-DL";
        public string ResolutionTag { get; set; } = "1080p";
        public string ReleaseGroup { get; set; } = "Smurfm3u";
        public int MaxConcurrentDownloads { get; set; } = 1;
        public int StartDelaySeconds { get; set; }
        public int SpeedLimitKibps { get; set; }
        public string? RefreshCron { get; set; } = "0 */6 * * *";
        public string? Headers { get; set; }

        public static SourceForm From(M3uSource source) => new()
        {
            Id = source.Id,
            Name = source.Name,
            Kind = source.Kind,
            Location = source.Location,
            Username = source.Username,
            Password = source.Password,
            IncludeSeries = source.IncludeSeries,
            SeriesConcurrency = source.SeriesConcurrency,
            Enabled = source.Enabled,
            QualityTag = source.QualityTag,
            ResolutionTag = source.ResolutionTag,
            ReleaseGroup = source.ReleaseGroup,
            MaxConcurrentDownloads = source.MaxConcurrentDownloads,
            StartDelaySeconds = source.StartDelaySeconds,
            SpeedLimitKibps = source.SpeedLimitKibps,
            RefreshCron = source.RefreshCron,
            Headers = source.Headers
        };

        public void ApplyTo(M3uSource source)
        {
            source.Name = Name.Trim();
            source.Kind = Kind;
            source.Location = Location.Trim();
            // Only meaningful for a panel, and left behind on a source switched away from one.
            source.Username = Blank(Username);
            source.Password = Blank(Password);
            source.IncludeSeries = IncludeSeries;
            source.SeriesConcurrency = Math.Clamp(SeriesConcurrency, 1, XtreamPace.MostAtOnce);

            // A pasted get.php link carries the credentials in its query string. Split them out
            // and keep the bare address: stored once rather than twice, and the list of
            // playlists shows an address rather than a password.
            if (Kind == M3uSourceKind.Xtream
                && XtreamCredentials.TryCreate(Location, Username, Password, out var panel, out _))
            {
                source.Location = panel.BaseUrl;
                source.Username = panel.Username;
                source.Password = panel.Password;
            }
            source.Enabled = Enabled;
            source.QualityTag = QualityTag?.Trim() ?? string.Empty;
            source.ResolutionTag = ResolutionTag?.Trim() ?? string.Empty;
            source.ReleaseGroup = ReleaseGroup?.Trim() ?? string.Empty;
            source.MaxConcurrentDownloads = Math.Clamp(MaxConcurrentDownloads, 1, 50);
            source.StartDelaySeconds = Math.Clamp(StartDelaySeconds, 0, 3600);
            source.SpeedLimitKibps = Math.Max(0, SpeedLimitKibps);
            source.RefreshCron = string.IsNullOrWhiteSpace(RefreshCron) ? null : RefreshCron.Trim();
            source.Headers = string.IsNullOrWhiteSpace(Headers) ? null : Headers.Trim();
        }

        private static string? Blank(string? value) =>
            string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }
}
