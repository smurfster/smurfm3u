@page "/search"
@attribute [Authorize]
@rendermode InteractiveServer
@inject SearchService Searcher
@inject DownloadService Downloads
@inject SettingsService SettingsStore
@inject SearchHistoryService History
@inject IDbContextFactory<AppDbContext> DbFactory
@using Microsoft.EntityFrameworkCore
@using Smurfm3u.Data
@using Smurfm3u.Core.Entities
@using System.Diagnostics

<PageTitle>Search - Smurfm3u</PageTitle>

<div class="page-header">
    <h1>Search</h1>
</div>

@if (message is not null)
{
    <div class="alert @(messageIsError ? "bad" : "ok")">@message</div>
}

<div class="card">
    <div class="field-grid">
        <div class="field" style="grid-column:1 / -1">
            <label>Title</label>
            <input @bind="query" @bind:event="oninput" @onkeydown="OnKeyDownAsync"
                   placeholder="Top Gear, Pacific Rim, ..." />
            <div class="hint">Leave blank to browse everything, newest first.</div>
        </div>
        <div class="field">
            <label>Kind</label>
            <select @bind="kind">
                <option value="@SearchKind.Search">Anything</option>
                <option value="@SearchKind.TvSearch">TV</option>
                <option value="@SearchKind.MovieSearch">Movies</option>
            </select>
        </div>
        <div class="field">
            <label>Season</label>
            <input type="number" min="0" @bind="season" placeholder="any" />
        </div>
        <div class="field">
            <label>Episode</label>
            <input type="number" min="0" @bind="episode" placeholder="any" />
        </div>

        @* Shown even with one playlist: it is where the feature lives, and a single tick
           becomes meaningful the moment a second playlist is added. *@
        @if (playlists.Count > 0)
        {
            <div class="field" style="grid-column:1 / -1">
                <label>Playlists</label>
                <div class="checkbox-row">
                    @foreach (var playlist in playlists)
                    {
                        <label>
                            <input type="checkbox" checked="@chosen.Contains(playlist.Id)"
                                   @onchange="e => TogglePlaylist(playlist.Id, e)" />
                            @playlist.Name
                        </label>
                    }
                </div>
                <div class="hint">
                    @(chosen.Count == 0
                        ? "Every playlist. Tick one or more to search only those."
                        : $"Searching {chosen.Count} of {playlists.Count} playlists.")
                </div>
            </div>
        }
    </div>

    <div class="actions">
        <button class="primary" @onclick="RunAsync" disabled="@searching">
            @(searching ? "Searching..." : "Search")
        </button>
        <button @onclick="ClearAsync" disabled="@searching">Clear</button>
    </div>
</div>

@if (searched)
{
    @if (relaxed)
    {
        <div class="card" style="padding:.7rem 1rem">
            <span class="pill warn">Closest matches</span>
            <span class="muted">
                Nothing contains every word of that query, so the nearest entries are shown instead.
            </span>
        </div>
    }

    @if (hits.Count == 0)
    {
        <div class="card empty">Nothing matched.</div>
    }
    else
    {
        <div class="card" style="padding:0">
            <table>
                <thead>
                <tr>
                    <th>Release</th>
                    <th>Kind</th>
                    <th class="secondary">Playlist</th>
                    <th class="numeric">Size</th>
                    <th class="secondary">Added</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var hit in hits)
                {
                    <tr>
                        <td class="grow">
                            <div class="mono">@hit.ReleaseName</div>
                            <div class="muted" style="font-size:.8rem">@hit.Item.RawTitle</div>
                        </td>
                        <td>
                            @* A season is offered as one release, so how many episodes are in
                               it is the thing worth knowing before grabbing it. *@
                            @if (hit.FileCount > 1)
                            {
                                <span class="pill ok">@hit.FileCount episodes</span>
                            }
                            else
                            {
                                <span class="pill">@(hit.Item.Kind == MediaKind.Series ? "TV" : "Movie")</span>
                            }
                        </td>
                        <td class="muted secondary">@(hit.Item.Source?.Name ?? "-")</td>
                        <td class="numeric">@SabFormat.Size(hit.SizeBytes)</td>
                        <td class="muted secondary">@hit.Item.FirstSeenAt.LocalDateTime.ToString("d MMM yyyy")</td>
                        <td>
                            @if (queued.Contains(hit.DownloadId))
                            {
                                <span class="pill ok">Queued</span>
                            }
                            else
                            {
                                <button class="small" @onclick="() => DownloadAsync(hit)">Download</button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <Pager Page="page" PageSize="pageSize" TotalCount="total"
               PageChanged="GoToPageAsync" PageSizeChanged="SetPageSizeAsync" />
    }
}

@code {
    private readonly List<SearchHit> hits = [];

    /// <summary>Entries queued from this page, so the button can say so without a reload.</summary>
    private readonly HashSet<string> queued = [];

    private string query = string.Empty;
    private SearchKind kind = SearchKind.Search;
    private int? season;
    private int? episode;

    /// <summary>The playlists that can be searched, and which of them were ticked.</summary>
    private List<PlaylistChoice> playlists = [];
    private readonly HashSet<int> chosen = [];

    private sealed record PlaylistChoice(int Id, string Name);

    private int total;
    private int page = 1;
    private int pageSize = 50;

    private bool searching;
    private bool searched;
    private bool relaxed;

    private string? message;
    private bool messageIsError;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        // Disabled playlists are left out: the search would not answer from one anyway, so
        // offering it here would only be a tickbox that changes nothing.
        playlists = await db.Sources
            .AsNoTracking()
            .Where(x => x.Enabled)
            .OrderBy(x => x.Name)
            .Select(x => new PlaylistChoice(x.Id, x.Name))
            .ToListAsync();
    }

    private void TogglePlaylist(int id, ChangeEventArgs e)
    {
        if (e.Value is true) chosen.Add(id);
        else chosen.Remove(id);
    }

    private Task OnKeyDownAsync(KeyboardEventArgs e) =>
        e.Key == "Enter" ? RunAsync() : Task.CompletedTask;

    /// <summary>A new query starts at the first page; paging keeps the one it is on.</summary>
    private Task RunAsync()
    {
        page = 1;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        searching = true;
        message = null;

        try
        {
            var request = new SearchRequest(
                kind,
                query,
                season is > 0 ? season : null,
                episode is > 0 ? episode : null,
                [],
                (page - 1) * pageSize,
                pageSize,
                chosen);

            var started = Stopwatch.GetTimestamp();
            var results = await Searcher.SearchAsync(request);
            var elapsed = Stopwatch.GetElapsedTime(started);

            hits.Clear();
            hits.AddRange(results.Hits);
            total = results.Total;
            relaxed = results.Relaxed;
            searched = true;

            // Recorded like any other query, so what was tried here sits alongside what the
            // *arr apps asked for - and the Results view works on it just the same.
            await History.RecordAsync(
                new SearchHistoryEntry
                {
                    Origin = SearchOrigin.WebUi,
                    Kind = request.Kind,
                    Query = request.Query,
                    Season = request.Season,
                    Episode = request.Episode,
                    Offset = request.Offset,
                    Limit = request.Limit,
                    ResultCount = results.Hits.Count,
                    Relaxed = results.Relaxed,
                    ElapsedMs = (int)elapsed.TotalMilliseconds
                },
                results.Hits.Select(x => x.Item.Id));
        }
        catch (Exception ex)
        {
            SetMessage($"Search failed: {ex.Message}", isError: true);
        }
        finally
        {
            searching = false;
        }
    }

    private Task GoToPageAsync(int target)
    {
        page = target;
        return LoadAsync();
    }

    private Task SetPageSizeAsync(int size)
    {
        pageSize = size;
        page = 1;
        return LoadAsync();
    }

    private Task ClearAsync()
    {
        query = string.Empty;
        season = null;
        episode = null;
        kind = SearchKind.Search;
        chosen.Clear();
        hits.Clear();
        queued.Clear();
        total = 0;
        page = 1;
        searched = false;
        relaxed = false;
        message = null;
        return Task.CompletedTask;
    }

    /// <summary>
    /// Queues the entry exactly as a grab from Sonarr or Radarr would, category included, so
    /// it lands in the same place and the *arr apps can still import it.
    /// </summary>
    private async Task DownloadAsync(SearchHit hit)
    {
        try
        {
            var settings = await SettingsStore.GetAsync();
            var category = hit.Item.Kind == MediaKind.Series ? settings.TvCategory : settings.MovieCategory;

            await Downloads.EnqueueAsync(hit.DownloadId, category, priority: null, nameOverride: null);

            queued.Add(hit.DownloadId);
            SetMessage($"Queued {hit.ReleaseName}.", isError: false);
        }
        catch (Exception ex)
        {
            SetMessage($"Could not queue that entry: {ex.Message}", isError: true);
        }
    }

    private void SetMessage(string text, bool isError)
    {
        message = text;
        messageIsError = isError;
    }
}
